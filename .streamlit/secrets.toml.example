# Anthropic API Configuration
#
# To use the Claude AI assistant in the dashboard:
# 1. Copy this file to secrets.toml (same directory)
# 2. Get your API key from https://console.anthropic.com
# 3. Replace "your-api-key-here" with your actual API key
#
# For Streamlit Cloud deployment:
# 1. Go to your app settings on share.streamlit.io
# 2. Add the ANTHROPIC_API_KEY in the Secrets section

ANTHROPIC_API_KEY = "your-api-key-here"
