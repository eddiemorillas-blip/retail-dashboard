# Retail Dashboard Secrets Configuration
#
# To use these settings locally:
# 1. Copy this file to secrets.toml (same directory)
# 2. Fill in your actual values
#
# For Streamlit Cloud deployment:
# 1. Go to your app settings on share.streamlit.io
# 2. Add secrets in the Secrets section (Settings > Secrets)

# =============================================================================
# Anthropic API (for Claude AI assistant)
# =============================================================================
# Get your API key from https://console.anthropic.com

ANTHROPIC_API_KEY = "your-api-key-here"

# =============================================================================
# Google Cloud / BigQuery Configuration
# =============================================================================
# Get service account credentials from your IT admin or GCP Console
# https://console.cloud.google.com/iam-admin/serviceaccounts
#
# IMPORTANT: Keep these credentials secret! Never commit to git.

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"

# =============================================================================
# BigQuery Data Configuration
# =============================================================================
# Configure which BigQuery dataset/tables to use

[bigquery]
dataset_id = "retail"
purchases_table = "purchases"
checkins_table = "checkins"
